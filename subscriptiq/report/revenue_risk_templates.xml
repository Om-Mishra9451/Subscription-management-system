<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_revenue_risk_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e1b4b;">
                            <div style="border-bottom: 2px solid #4f46e5; padding-bottom: 15px; margin-bottom: 25px;">
                                <h1 style="color: #4f46e5; margin: 0; font-size: 26px;">SubscriptIQ Revenue Assurance Report</h1>
                                <p style="color: #6b7280; font-size: 13px; margin: 5px 0 0 0;">
                                    Executive Snapshot for <t t-out="doc.company_id.name"/> | Date: <t t-out="doc.snapshot_date"/>
                                </p>
                            </div>

                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                                <tr>
                                    <td style="width: 33%; padding: 15px; background-color: #f5f3ff; border: 1px solid #ddd6fe; border-radius: 6px;">
                                        <div style="font-size: 12px; color: #4338ca; text-transform: uppercase; font-weight: bold;">Verified Recovered Revenue</div>
                                        <div style="font-size: 24px; color: #16a34a; font-weight: bold; margin-top: 5px;">
                                            <t t-out="doc.company_id.currency_id.symbol or '₹'"/><t t-out="'%.2f' % doc.recovered_revenue"/>
                                        </div>
                                    </td>
                                    <td style="width: 33%; padding: 15px; background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;">
                                        <div style="font-size: 12px; color: #b91c1c; text-transform: uppercase; font-weight: bold;">Revenue at Risk</div>
                                        <div style="font-size: 24px; color: #dc2626; font-weight: bold; margin-top: 5px;">
                                            <t t-out="doc.company_id.currency_id.symbol or '₹'"/><t t-out="'%.2f' % doc.revenue_at_risk"/>
                                        </div>
                                    </td>
                                    <td style="width: 33%; padding: 15px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px;">
                                        <div style="font-size: 12px; color: #475569; text-transform: uppercase; font-weight: bold;">Leakage Exposure Rate</div>
                                        <div style="font-size: 24px; color: #0284c7; font-weight: bold; margin-top: 5px;">
                                            <t t-out="'%.2f' % doc.leakage_rate"/>%
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <h3 style="color: #312e81; font-size: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px;">Core Recurring Baseline</h3>
                            <table style="width: 100%; margin-bottom: 25px; font-size: 14px;">
                                <tr>
                                    <td><strong>Monthly Recurring Revenue (MRR):</strong></td>
                                    <td><t t-out="doc.company_id.currency_id.symbol or '₹'"/><t t-out="'%.2f' % doc.mrr"/></td>
                                    <td><strong>Annualized Recurring Revenue (ARR):</strong></td>
                                    <td><t t-out="doc.company_id.currency_id.symbol or '₹'"/><t t-out="'%.2f' % doc.arr"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Active Software Subscriptions:</strong></td>
                                    <td><t t-out="doc.active_subscriptions"/></td>
                                    <td><strong>Overdue Debt Outstanding:</strong></td>
                                    <td><t t-out="doc.company_id.currency_id.symbol or '₹'"/><t t-out="'%.2f' % doc.overdue_amount"/></td>
                                </tr>
                            </table>

                            <div style="margin-top: 40px; font-size: 11px; color: #9ca3af; text-align: center; border-top: 1px solid #e5e7eb; padding-top: 10px;">
                                Generated autonomously by SubscriptIQ — Autonomous Revenue Assurance for Odoo. Cryptographically verified against accounting records.
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
