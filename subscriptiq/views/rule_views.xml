<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Rule Tree View -->
        <record id="view_subscriptiq_rule_tree" model="ir.ui.view">
            <field name="name">subscriptiq.rule.tree</field>
            <field name="model">subscriptiq.rule</field>
            <field name="arch" type="xml">
                <tree string="Revenue Assurance Rules">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="rule_type"/>
                    <field name="severity"/>
                    <field name="threshold"/>
                    <field name="enabled"/>
                    <field name="version"/>
                </tree>
            </field>
        </record>

        <!-- Rule Form View -->
        <record id="view_subscriptiq_rule_form" model="ir.ui.view">
            <field name="name">subscriptiq.rule.form</field>
            <field name="model">subscriptiq.rule</field>
            <field name="arch" type="xml">
                <form string="Detection Rule Configuration">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Rule Parameters">
                                <field name="code"/>
                                <field name="rule_type"/>
                                <field name="severity"/>
                                <field name="threshold"/>
                                <field name="enabled"/>
                            </group>
                            <group string="Scope &amp; Validity">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="version"/>
                                <field name="effective_from"/>
                                <field name="effective_until"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Condition Configuration (JSON)">
                                <field name="condition_config"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Rules -->
        <record id="action_subscriptiq_rules" model="ir.actions.act_window">
            <field name="name">Detection Rules</field>
            <field name="res_model">subscriptiq.rule</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
