# SubscriptIQ - Autonomous Revenue Assurance Engine for Odoo
# Free-Tier AI Provider Configuration (NO PAID APIS ALLOWED)

# Groq (Primary Provider - Free Developer Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Secondary Provider - Free Developer Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (Third Provider - Strictly $0/token Free Models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FREE_MODELS_ONLY=true

# AI Provider Priority & Fallback Chain
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDERS=gemini,openrouter

# Execution & Network Safety
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
